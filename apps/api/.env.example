APP_ENV=development
RENTCAST_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
ENABLE_LIVE_VALUATIONS=false
ENABLE_DEMO_MODE=true
PROVIDER_REQUEST_TIMEOUT_SECONDS=12
MAX_SEARCHES_PER_IP_PER_HOUR=30
VALUATION_CACHE_TTL_SECONDS=21600
VALUATION_CACHE_MAX_ENTRIES=200
ADDRESS_SEARCH_CACHE_TTL_SECONDS=21600
ADDRESS_SEARCH_MIN_CHARS=5
PORT=8000
